# Copia este archivo como ".env" (NO se sube a git) y completa los valores.
FUSIONSOLAR_USER=
FUSIONSOLAR_PASSWORD=

# Estado local (CSV maestro, logs, capturas). FUERA de OneDrive:
# En Windows reemplaza %LOCALAPPDATA% por la ruta real, p. ej. C:\Users\dali.huaman\AppData\Local\FusionSolar\state
FUSIONSOLAR_STATE=C:\Users\dali.huaman\AppData\Local\FusionSolar\state

# Carpeta donde vive el Excel historico (OneDrive)
EXCEL_DIR=C:\Users\dali.huaman\OneDrive - KALLPA GENERACION S.A\Kondu\Dalí\Edson\FusionSolar\Indicadores
EXCEL_NOMBRE=Indicadores_FusionSolar.xlsx

# Publicacion del dashboard (GitHub Pages, rama gh-pages del repo)
GITHUB_REPO=dalihuaman/fusionsolar
# Token personal (fine-grained, permiso "Contents: read/write" SOLO sobre este repo).
# Si ya tienes Git Credential Manager configurado en esa PC puedes dejarlo vacio.
GITHUB_TOKEN=

# Opcional: ruta a un Chromium/Chrome ya instalado (si no, se usa el de Playwright)
CHROMIUM_PATH=
